[Unit]
Description=Savia IoT - servidor de telemetria
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=savia
Group=savia
WorkingDirectory=/opt/savia-iot/server
EnvironmentFile=/etc/savia-iot.env
ExecStart=/opt/savia-iot/.venv/bin/python /opt/savia-iot/server/app.py
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/savia-iot

[Install]
WantedBy=multi-user.target
