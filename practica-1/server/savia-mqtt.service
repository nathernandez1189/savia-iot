[Unit]
Description=Savia IoT - archivo de lecturas Wokwi por MQTT
After=network-online.target savia-iot.service
Wants=network-online.target savia-iot.service

[Service]
Type=simple
User=savia
Group=savia
WorkingDirectory=/opt/savia-iot/server
EnvironmentFile=/etc/savia-iot.env
ExecStart=/opt/savia-iot/.venv/bin/python /opt/savia-iot/server/mqtt_bridge.py
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
