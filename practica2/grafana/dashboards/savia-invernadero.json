  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Temperatura del aire interior (simulada)",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "influxdb", "uid": "savia-influx"},
      "targets": [{"refId": "A", "query": "from(bucket: \"invernadero\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"invernadero_aire\" and r._field == \"temperatura\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)", "datasource": {"type": "influxdb", "uid": "savia-influx"}}],
      "fieldConfig": {"defaults": {"unit": "celsius", "min": -40, "max": 80}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Humedad relativa del aire interior (simulada)",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "influxdb", "uid": "savia-influx"},
      "targets": [{"refId": "A", "query": "from(bucket: \"invernadero\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"invernadero_aire\" and r._field == \"humedad\") |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)", "datasource": {"type": "influxdb", "uid": "savia-influx"}}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Última temperatura",
      "gridPos": {"h": 5, "w": 12, "x": 0, "y": 9},
      "datasource": {"type": "influxdb", "uid": "savia-influx"},
      "targets": [{"refId": "A", "query": "from(bucket: \"invernadero\") |> range(start: -30m) |> filter(fn: (r) => r._measurement == \"invernadero_aire\" and r._field == \"temperatura\") |> last()", "datasource": {"type": "influxdb", "uid": "savia-influx"}}],
      "fieldConfig": {"defaults": {"unit": "celsius", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 30}]}}, "overrides": []}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Última humedad relativa",
      "gridPos": {"h": 5, "w": 12, "x": 12, "y": 9},
      "datasource": {"type": "influxdb", "uid": "savia-influx"},
      "targets": [{"refId": "A", "query": "from(bucket: \"invernadero\") |> range(start: -30m) |> filter(fn: (r) => r._measurement == \"invernadero_aire\" and r._field == \"humedad\") |> last()", "datasource": {"type": "influxdb", "uid": "savia-influx"}}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 50}, {"color": "red", "value": 85}]}}, "overrides": []}
